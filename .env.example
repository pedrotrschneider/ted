# Generate a URL-safe value with Node crypto.randomBytes(32).toString('hex') in Devbox.
# Never commit the real .env.
TED_DB_PASSWORD=replace-with-a-random-hex-password
# Default binds only to this host. Set 0.0.0.0 for deliberate LAN exposure.
TED_BIND_ADDRESS=127.0.0.1
TED_PORT=8080
# Default requires HTTPS at your reverse proxy for browser session cookies.
# Set true only for deliberate plain-HTTP localhost/LAN development.
TED_INSECURE_HTTP=false
# Password minimum in Unicode characters; zero permits an empty password.
TED_MIN_PASSWORD_LENGTH=0
# Native opaque bearer/refresh tokens. Go durations; 720h=30d, 2160h=90d.
# Require access >=1s and access < refresh inactivity <= absolute family TTL.
TED_ACCESS_TOKEN_TTL=10m
TED_REFRESH_TOKEN_IDLE_TTL=720h
TED_TOKEN_FAMILY_TTL=2160h
# Host files, never a Docker-managed volume. Use /Config for an absolute root.
TED_CONFIG_DIR=./Config
# Host folder for owned local movies and resumable staging files (same filesystem).
TED_MEDIA_DIR=./Media
# Match the owner of the media and metadata folders (id -u / id -g).
TED_UID=10001
TED_GID=10001

# Configure RD/TMDb/TVDB in the administrator web UI: Your account → Server providers.

# Concurrent durable mapping probes (1–4); download concurrency is unchanged.
TED_MAPPING_WORKERS=4

# Atomic episode assignments per batch (1–500); snapshotted per submission.
TED_MAPPING_BATCH_SIZE=200

# Calendar day used for episode release eligibility (IANA timezone).
TED_TIMEZONE=UTC

# Native descriptive metadata locale. Credentials are saved through the web UI.
TED_METADATA_LANGUAGE=en
TED_METADATA_COUNTRY=US
# Compose binds Config/metadata automatically. For devbox serve, set an absolute path:
# TED_METADATA_DIR=/absolute/path/to/Config/metadata
